{
	// Generated by `svelte-kit sync` into node_modules/$app (module resolution, lib, verbatimModuleSyntax, ...)
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		// Overriding `types` replaces the base list, so keep $app/types; Node is needed by the
		// Vite/Vitest configs and a few tests (TypeScript 6 no longer includes @types/* implicitly)
		"types": ["$app/types", "node"]
	},
	"include": ["src", "vite.config.ts", "vitest.config.ts", "vitest-setup.ts"]
}
