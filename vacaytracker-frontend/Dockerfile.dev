# Development Dockerfile with hot-reload (SvelteKit 3 requires Node 22.17+)
FROM node:22-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm ci

# Copy source files
COPY . .

EXPOSE 5173

# Run dev server with host binding for Docker access
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
